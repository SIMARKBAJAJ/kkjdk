# Copy to .env. Never commit .env.
# On Vercel, enter the same names under Project Settings > Environment Variables.
# Locally, .env is also what "npm run door" uses, so point it at the live database to create invites.

# Public address of the site. https:// when deployed.
# On Vercel you can leave this out: the production address is detected automatically.
# For "npm run door", set it to your live address so the invite links are right.
BASE_URL=http://localhost:3000
PORT=3000
# Vercel sets NODE_ENV=production by itself. Set it yourself only on other hosts.
NODE_ENV=development

# Database (Turso). Leave both empty to use a local file (door.db) while developing.
# Get them from the Turso dashboard: create a database, then copy its URL and create a token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# LiveKit Cloud project: https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web Push keys. Make a pair with:  npm run vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# Optional backup alert. Make a bot with @BotFather, send it a message, then find the chat id
# in https://api.telegram.org/bot<TOKEN>/getUpdates and pass it to "door.js new".
TELEGRAM_BOT_TOKEN=
